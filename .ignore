# ==============================================================================
# BamOS & BamApps Ignore Configuration for Antigravity & AI Agents
# (.antigravityignore, .geminiignore, .ignore)
# Giúp tiết kiệm tối đa Token AI và tăng tốc độ indexing
# ==============================================================================

# Git internals
.git/

# Build outputs, derivations & binaries
result
result*
result-*/
build/
dist/
bin/
target/
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# Development environments & Package Managers
.devenv/
.direnv/
.devenv.flake.nix
node_modules/
.pnpm-store/
Cargo.lock
pnpm-lock.yaml
devenv.lock
flake.lock

# Binary & heavy static assets
assets/images/
assets/fonts/
assets/icons/

# Installer assets & temporary build caches
installer/calamares/
installer/iso/
*.iso

# System hardware & machine state
hardware-configuration.nix

# Database, Vector DB, Logs & Caches
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/*.db
data/cache/
*.log
logs/
.cache/

# AI Models & Large Weights
*.gguf
*.bin
*.onnx
*.pt
*.safetensors
models/

# Python & shell caches
__pycache__/
*.pyc

# Editor & IDE temporary caches
.vscode/
.idea/
*.swp
*~
Thumbs.db
.DS_Store
